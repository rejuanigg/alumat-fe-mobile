rules_version = '2';

// Reglas de Firestore para ALUMAT.
// Publicarlas en Firebase Console → Firestore Database → Reglas (o con `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Imágenes guardadas como data URL JPEG dentro del documento (máx. ~700 KB de texto).
    function validImage(v) {
      return v == null || (v is string && v.size() <= 750000);
    }

    // Perfil: cada persona lee y edita solo el suyo.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && validImage(request.resource.data.photoUri);
      allow delete: if false;
    }

    // Catálogo compartido por todo el personal con sesión iniciada.
    match /products/{id} {
      allow read, delete: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 60
        && request.resource.data.category in ['Ventanas', 'Puertas', 'Persianas', 'Accesorios', 'Otros']
        && request.resource.data.price is number && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0 && request.resource.data.stock <= 99999
        && request.resource.data.description is string && request.resource.data.description.size() <= 200
        && validImage(request.resource.data.imageUri);
    }

    // Marca de que ya se cargaron los productos de ejemplo.
    match /meta/seed {
      allow read, create: if signedIn();
    }
  }
}
