rules_version = '2';

// Reglas de Firestore para ALUMAT.
// Publicarlas en Firebase Console → Firestore Database → Reglas (o con `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Imágenes guardadas como data URL JPEG dentro del documento (máx. ~700 KB de texto).
    function validImage(v) {
      return v == null || (v is string && v.size() <= 750000);
    }

    // Perfil: cada persona lee y edita solo el suyo.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.phone is string
        && validImage(request.resource.data.photoUri);
      allow delete: if false;
    }

    // `deletedAt`: eliminado lógico. Ausente o null = activo; string ISO = eliminado (recuperable).
    function validDeletedAt(data) {
      return !('deletedAt' in data) || data.deletedAt == null || data.deletedAt is string;
    }

    // Catálogo compartido por todo el personal con sesión iniciada.
    // No se permite borrar documentos: se eliminan de forma lógica con `deletedAt`.
    function isActive(data) {
      return !('deletedAt' in data) || data.deletedAt == null;
    }

    function validProduct(data) {
      return validDeletedAt(data)
        && data.name is string
        && data.name.size() >= 3 && data.name.size() <= 60
        && data.category in ['Ventanas', 'Puertas', 'Persianas', 'Accesorios', 'Otros']
        && data.price is number && data.price > 0
        && data.stock is int
        && data.stock >= 0 && data.stock <= 99999
        && data.description is string && data.description.size() <= 200
        && validImage(data.imageUri);
    }

    match /products/{id} {
      allow read: if signedIn();
      allow delete: if false;
      // Todo producto nace activo.
      allow create: if signedIn() && isActive(request.resource.data) && validProduct(request.resource.data);
      // Un producto eliminado solo puede cambiar `deletedAt` (recuperarlo): sus datos no se editan.
      // `createdAt` no cambia después de crear el producto.
      allow update: if signedIn()
        && (isActive(resource.data)
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt']))
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && validProduct(request.resource.data);
    }

    // Marca de que ya se cargaron los productos de ejemplo.
    match /meta/seed {
      allow read, create: if signedIn();
    }
  }
}
